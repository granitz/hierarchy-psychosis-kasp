# Copy this file to `.env` (same directory) and edit the paths.
#
#   cp .env.example .env
#
# `.env` is git-ignored, so your local absolute paths never get committed.
# It is read automatically whenever `kasp` is imported, which means it also
# reaches Jupyter kernels that were not launched from your shell.
#
# Quote any path containing a space.

# The project root: the folder holding the subject-list .mat files plus the
# results/ and data/ directories. Setting this alone is usually enough.
KASP_DATA="/path/to/tmp/"

# Name of this run; outputs go to runs/<KASP_RUN_TAG>/.
KASP_RUN_TAG=main

# Only needed if your layout differs from the defaults below, which are
# relative to KASP_DATA:
#   KASP_RESULTS        results/results_subject_refinement
#   KASP_GROUP_RESULTS  results/results_group_only
#   KASP_TIMESERIES     data/tseries_2/mat_files      (.mat timeseries)
#   KASP_TSNR           data/tseries_2                (.json sidecars)
#   KASP_MOTION         data/MOTION
#   KASP_DERIVED        data/derived_data
#   KASP_CLINICAL       data/clinical
#
# KASP_TIMESERIES="/path/to/tseries_2/mat_files"
# KASP_CLINICAL="/path/to/clinical"

# --------------------------------------------------------------------------
# Atlas. Defaults to the 416-parcel atlas. For the 116-parcel atlas
# set all three together; the timeseries filename suffix follows KASP_ATLAS.
# --------------------------------------------------------------------------
# KASP_ATLAS="SchaeferTian116"
# KASP_N_CORTEX="100"
# KASP_N_SUBCORTEX="16"
#
# The subject lists are shared across atlases, so when KASP_DATA points at an
# atlas-specific tree they need pointing back at the project root:
# KASP_SUBJECTS_CTRL="/path/to/proj/subjects_ctrl_clean_good_coverage.mat"
# KASP_SUBJECTS_SZ="/path/to/proj/subjects_sz_clean_good_coverage.mat"
# KASP_IS_MED="/path/to/proj/is_med.mat"
